{
  "name": "hello-fabric",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@dsh-do/fabric"],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "pnpm run typecheck && tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@dsh-do/fabric": "^0.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@dsh-do/fabric": "workspace:*",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ]
}
